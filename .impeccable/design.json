      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:18px;background:#07505a linear-gradient(135deg,#0b6f7a 0%,#0e827f 100%);color:#fff;font:600 14px/1 'Plus Jakarta Sans',ui-sans-serif,system-ui,sans-serif;box-shadow:0 10px 22px -10px rgb(11 111 122/.65);cursor:pointer;transition:filter .15s}.ds-btn-primary:hover{filter:brightness(1.1)}.ds-btn-primary:active{filter:brightness(.95)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px rgb(7 80 90/.8)}"
